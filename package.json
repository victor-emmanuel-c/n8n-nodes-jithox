{
  "name": "n8n-nodes-jithox",
  "version": "0.1.0",
  "description": "n8n community node for Jithox: verify EU VAT numbers against VIES from a workflow.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://jithox.com",
  "author": {
    "name": "Jithox",
    "email": "hello@jithox.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-emmanuel-c/n8n-nodes-jithox.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:icons",
    "copy:icons": "node -e \"require('fs').mkdirSync('dist/nodes/JithoxVat',{recursive:true});require('fs').copyFileSync('nodes/JithoxVat/jithox.svg','dist/nodes/JithoxVat/jithox.svg')\"",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JithoxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JithoxVat/JithoxVat.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
