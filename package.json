{
  "name": "n8n-nodes-jithox",
  "version": "0.1.1",
  "description": "n8n community node for Jithox: verify EU VAT numbers against VIES from a workflow.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://jithox.com",
  "author": {
    "name": "Jithox",
    "email": "hello@jithox.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-emmanuel-c/n8n-nodes-jithox.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:icons",
    "copy:icons": "node -e \"const fs=require('fs');fs.mkdirSync('dist/nodes/JithoxVat',{recursive:true});for(const f of ['jithox.svg','jithox.dark.svg'])fs.copyFileSync('nodes/JithoxVat/'+f,'dist/nodes/JithoxVat/'+f)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint package.json nodes credentials",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JithoxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JithoxVat/JithoxVat.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.34.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
